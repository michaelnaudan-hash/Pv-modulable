{
  "name": "pv-etancheite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PV de contrôle de chantier - étanchéité des ouvrages d'art (PWA offline-first, sans serveur, sans authentification)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "serve:dist": "python3 scripts/serve-dist.py",
    "icons": "node scripts/generate-icons.mjs",
    "test:backup": "esbuild scripts/test-backup.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-backup.mjs --log-level=warning && node node_modules/.cache/test-backup.mjs",
    "test:docs": "esbuild scripts/test-docs.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-docs.mjs --log-level=warning && node node_modules/.cache/test-docs.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "docx": "^8.5.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-pwa": "^0.20.5",
    "fake-indexeddb": "^6.0.0"
  }
}